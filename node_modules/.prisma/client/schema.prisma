generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SCHOOL_ADMIN
  TEACHER
  BURSAR
  PARENT
  STUDENT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum StudentStatus {
  ACTIVE
  GRADUATED
  TRANSFERRED
  INACTIVE
}

enum StaffKind {
  TEACHER
  ADMIN
  BURSAR
  SUPPORT
}

enum PaymentStatus {
  PAID
  PENDING
  VOID
}

enum InvoiceStatus {
  OPEN
  PARTIAL
  PAID
  VOID
}

enum PaymentMethod {
  CASH
  BANK
  MOBILE_MONEY
  OTHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum PortalLinkType {
  PARENT
  STUDENT
}

enum AnnouncementAudience {
  ALL
  PARENT
  STUDENT
}

enum SubscriptionPlanCode {
  STARTER
  GROWTH
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  CANCELLED
}

enum AuditAction {
  INVOICE_PAYMENT_CREATED
  REPORT_EXPORTED
  SUBSCRIPTION_PLAN_SELECTED
}

model School {
  id                  String               @id @default(uuid()) @db.Uuid
  name                String
  slug                String               @unique
  addressLine1        String?              @map("address_line1")
  addressLine2        String?              @map("address_line2")
  city                String?
  country             String?
  phone               String?
  contactEmail        String?              @map("contact_email")
  timezone            String               @default("UTC")
  motto               String?
  academicYear        String?              @map("academic_year")
  term                String?
  currency            String               @default("USD")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  memberships         Membership[]
  students            Student[]
  staff               Staff[]
  payments            Payment[]
  academicYears       AcademicYear[]
  schoolClasses       SchoolClass[]
  subjects            Subject[]
  teachingAssignments TeachingAssignment[]
  attendanceRecords   AttendanceRecord[]
  examinations        Examination[]
  gradeBands          GradeBand[]
  enrollments         StudentEnrollment[]
  feeStructures       FeeStructure[]
  invoices            Invoice[]
  portalLinks         StudentPortalLink[]
  announcements       Announcement[]
  notifications       PortalNotification[]
  subscription        SchoolSubscription?
  auditLogs           AuditLogEntry[]

  @@map("schools")
}

model User {
  id            String               @id @default(uuid()) @db.Uuid
  email         String               @unique
  passwordHash  String               @map("password_hash")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")
  memberships   Membership[]
  staffProfile  Staff?
  portalLinks   StudentPortalLink[]
  notifications PortalNotification[]
  auditLogs     AuditLogEntry[]

  @@map("users")
}

model Membership {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      Role
  createdAt DateTime @default(now()) @map("created_at")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([schoolId, userId])
  @@index([userId])
  @@index([schoolId])
  @@map("memberships")
}

model Student {
  id            String              @id @default(uuid()) @db.Uuid
  schoolId      String              @map("school_id") @db.Uuid
  admissionNo   String              @map("admission_no")
  fullName      String              @map("full_name")
  dateOfBirth   DateTime            @map("date_of_birth") @db.Date
  gender        Gender
  className     String              @map("class_name")
  guardianName  String              @map("guardian_name")
  guardianPhone String?             @map("guardian_phone")
  guardianEmail String?             @map("guardian_email")
  status        StudentStatus       @default(ACTIVE)
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  school        School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  attendance    AttendanceRecord[]
  examMarks     ExamMark[]
  enrollments   StudentEnrollment[]
  invoices      Invoice[]
  portalLinks   StudentPortalLink[]

  @@unique([schoolId, admissionNo])
  @@index([schoolId, status])
  @@index([schoolId, className])
  @@map("students")
}

model Staff {
  id          String               @id @default(uuid()) @db.Uuid
  schoolId    String               @map("school_id") @db.Uuid
  employeeId  String?              @map("employee_id")
  fullName    String               @map("full_name")
  email       String?
  phone       String?
  jobTitle    String?              @map("job_title")
  department  String?
  hireDate    DateTime?            @map("hire_date") @db.Date
  kind        StaffKind
  active      Boolean              @default(true)
  userId      String?              @unique @map("user_id") @db.Uuid
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  school      School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user        User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  assignments TeachingAssignment[]

  @@unique([schoolId, employeeId])
  @@index([schoolId, active])
  @@index([schoolId, kind])
  @@map("staff")
}

model AcademicYear {
  id            String               @id @default(uuid()) @db.Uuid
  schoolId      String               @map("school_id") @db.Uuid
  name          String
  startDate     DateTime             @map("start_date") @db.Date
  endDate       DateTime             @map("end_date") @db.Date
  isCurrent     Boolean              @default(false) @map("is_current")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")
  school        School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classes       SchoolClass[]
  assignments   TeachingAssignment[]
  examinations  Examination[]
  enrollments   StudentEnrollment[]
  feeStructures FeeStructure[]

  @@unique([schoolId, name])
  @@index([schoolId, isCurrent])
  @@map("academic_years")
}

model SchoolClass {
  id             String               @id @default(uuid()) @db.Uuid
  schoolId       String               @map("school_id") @db.Uuid
  academicYearId String               @map("academic_year_id") @db.Uuid
  name           String
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  school         School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear         @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  streams        Stream[]
  assignments    TeachingAssignment[]
  examinations   Examination[]
  enrollments    StudentEnrollment[]
  feeStructures  FeeStructure[]

  @@unique([schoolId, academicYearId, name])
  @@map("classes")
}

model Stream {
  id          String               @id @default(uuid()) @db.Uuid
  schoolId    String               @map("school_id") @db.Uuid
  classId     String               @map("class_id") @db.Uuid
  name        String
  capacity    Int?
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  schoolClass SchoolClass          @relation(fields: [classId], references: [id], onDelete: Cascade)
  assignments TeachingAssignment[]
  enrollments StudentEnrollment[]

  @@unique([classId, name])
  @@index([schoolId])
  @@map("streams")
}

model Subject {
  id          String               @id @default(uuid()) @db.Uuid
  schoolId    String               @map("school_id") @db.Uuid
  code        String
  name        String
  active      Boolean              @default(true)
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  school      School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignments TeachingAssignment[]
  examPapers  ExamPaper[]
  examMarks   ExamMark[]

  @@unique([schoolId, code])
  @@map("subjects")
}

model TeachingAssignment {
  id             String       @id @default(uuid()) @db.Uuid
  schoolId       String       @map("school_id") @db.Uuid
  staffId        String       @map("staff_id") @db.Uuid
  subjectId      String       @map("subject_id") @db.Uuid
  classId        String       @map("class_id") @db.Uuid
  streamId       String?      @map("stream_id") @db.Uuid
  academicYearId String       @map("academic_year_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at")
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staff          Staff        @relation(fields: [staffId], references: [id], onDelete: Cascade)
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  schoolClass    SchoolClass  @relation(fields: [classId], references: [id], onDelete: Cascade)
  stream         Stream?      @relation(fields: [streamId], references: [id], onDelete: SetNull)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([schoolId, staffId, subjectId, classId, streamId, academicYearId])
  @@index([schoolId])
  @@map("teaching_assignments")
}

model Payment {
  id        String        @id @default(uuid()) @db.Uuid
  schoolId  String        @map("school_id") @db.Uuid
  amount    Decimal       @db.Decimal(12, 2)
  status    PaymentStatus @default(PAID)
  paidAt    DateTime      @default(now()) @map("paid_at")
  createdAt DateTime      @default(now()) @map("created_at")
  school    School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, status])
  @@map("payments")
}

model AttendanceRecord {
  id         String           @id @default(uuid()) @db.Uuid
  schoolId   String           @map("school_id") @db.Uuid
  studentId  String           @map("student_id") @db.Uuid
  recordDate DateTime         @map("record_date") @db.Date
  className  String           @map("class_name")
  status     AttendanceStatus
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")
  school     School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([schoolId, studentId, recordDate])
  @@index([schoolId, recordDate, className])
  @@map("attendance_records")
}

model Examination {
  id             String       @id @default(uuid()) @db.Uuid
  schoolId       String       @map("school_id") @db.Uuid
  academicYearId String       @map("academic_year_id") @db.Uuid
  classId        String       @map("class_id") @db.Uuid
  term           String
  name           String
  published      Boolean      @default(false)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  schoolClass    SchoolClass  @relation(fields: [classId], references: [id], onDelete: Cascade)
  papers         ExamPaper[]
  marks          ExamMark[]

  @@index([schoolId, academicYearId])
  @@map("examinations")
}

model ExamPaper {
  id            String      @id @default(uuid()) @db.Uuid
  examinationId String      @map("examination_id") @db.Uuid
  subjectId     String      @map("subject_id") @db.Uuid
  maxMarks      Int         @map("max_marks")
  examination   Examination @relation(fields: [examinationId], references: [id], onDelete: Cascade)
  subject       Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([examinationId, subjectId])
  @@map("exam_papers")
}

model ExamMark {
  id            String      @id @default(uuid()) @db.Uuid
  schoolId      String      @map("school_id") @db.Uuid
  examinationId String      @map("examination_id") @db.Uuid
  studentId     String      @map("student_id") @db.Uuid
  subjectId     String      @map("subject_id") @db.Uuid
  score         Decimal     @db.Decimal(8, 2)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  examination   Examination @relation(fields: [examinationId], references: [id], onDelete: Cascade)
  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject       Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([examinationId, studentId, subjectId])
  @@index([schoolId])
  @@map("exam_marks")
}

model GradeBand {
  id         String @id @default(uuid()) @db.Uuid
  schoolId   String @map("school_id") @db.Uuid
  label      String
  minPercent Float  @map("min_percent")
  maxPercent Float  @map("max_percent")
  sortOrder  Int    @default(0) @map("sort_order")
  school     School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, label])
  @@map("grade_bands")
}

model StudentEnrollment {
  id             String       @id @default(uuid()) @db.Uuid
  schoolId       String       @map("school_id") @db.Uuid
  studentId      String       @map("student_id") @db.Uuid
  academicYearId String       @map("academic_year_id") @db.Uuid
  classId        String       @map("class_id") @db.Uuid
  streamId       String?      @map("stream_id") @db.Uuid
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  schoolClass    SchoolClass  @relation(fields: [classId], references: [id], onDelete: Cascade)
  stream         Stream?      @relation(fields: [streamId], references: [id], onDelete: SetNull)

  @@unique([schoolId, studentId, academicYearId])
  @@index([schoolId, classId])
  @@map("student_enrollments")
}

model FeeStructure {
  id             String       @id @default(uuid()) @db.Uuid
  schoolId       String       @map("school_id") @db.Uuid
  academicYearId String       @map("academic_year_id") @db.Uuid
  classId        String?      @map("class_id") @db.Uuid
  term           String
  name           String
  amount         Decimal      @db.Decimal(12, 2)
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  schoolClass    SchoolClass? @relation(fields: [classId], references: [id], onDelete: SetNull)
  invoices       Invoice[]

  @@index([schoolId, academicYearId, term])
  @@map("fee_structures")
}

model Invoice {
  id             String           @id @default(uuid()) @db.Uuid
  schoolId       String           @map("school_id") @db.Uuid
  studentId      String           @map("student_id") @db.Uuid
  feeStructureId String?          @map("fee_structure_id") @db.Uuid
  invoiceNo      String           @map("invoice_no")
  description    String
  amountTotal    Decimal          @map("amount_total") @db.Decimal(12, 2)
  amountPaid     Decimal          @default(0) @map("amount_paid") @db.Decimal(12, 2)
  status         InvoiceStatus    @default(OPEN)
  dueDate        DateTime?        @map("due_date") @db.Date
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  school         School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructure   FeeStructure?    @relation(fields: [feeStructureId], references: [id], onDelete: SetNull)
  payments       InvoicePayment[]

  @@unique([schoolId, invoiceNo])
  @@index([schoolId, status])
  @@map("invoices")
}

model InvoicePayment {
  id        String        @id @default(uuid()) @db.Uuid
  schoolId  String        @map("school_id") @db.Uuid
  invoiceId String        @map("invoice_id") @db.Uuid
  amount    Decimal       @db.Decimal(12, 2)
  method    PaymentMethod
  reference String?
  paidAt    DateTime      @default(now()) @map("paid_at")
  createdAt DateTime      @default(now()) @map("created_at")
  invoice   Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([schoolId, paidAt])
  @@map("invoice_payments")
}

model StudentPortalLink {
  id        String         @id @default(uuid()) @db.Uuid
  schoolId  String         @map("school_id") @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  studentId String         @map("student_id") @db.Uuid
  linkType  PortalLinkType @map("link_type")
  createdAt DateTime       @default(now()) @map("created_at")
  school    School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  student   Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([schoolId, userId, studentId])
  @@index([schoolId, userId])
  @@map("student_portal_links")
}

model Announcement {
  id        String               @id @default(uuid()) @db.Uuid
  schoolId  String               @map("school_id") @db.Uuid
  audience  AnnouncementAudience
  title     String
  body      String
  createdAt DateTime             @default(now()) @map("created_at")
  school    School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, audience])
  @@map("announcements")
}

model PortalNotification {
  id        String    @id @default(uuid()) @db.Uuid
  schoolId  String    @map("school_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  title     String
  body      String
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId, userId, readAt])
  @@map("portal_notifications")
}

model SchoolSubscription {
  id          String               @id @default(uuid()) @db.Uuid
  schoolId    String               @unique @map("school_id") @db.Uuid
  planCode    SubscriptionPlanCode @map("plan_code")
  status      SubscriptionStatus   @default(TRIAL)
  trialEndsAt DateTime?            @map("trial_ends_at")
  selectedAt  DateTime             @default(now()) @map("selected_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  school      School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("school_subscriptions")
}

model AuditLogEntry {
  id        String      @id @default(uuid()) @db.Uuid
  schoolId  String      @map("school_id") @db.Uuid
  userId    String?     @map("user_id") @db.Uuid
  action    AuditAction
  detail    Json        @default("{}")
  createdAt DateTime    @default(now()) @map("created_at")
  school    School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt])
  @@map("audit_log_entries")
}

model Session {
  sid    String   @id @db.VarChar(255)
  sess   Json
  expire DateTime @db.Timestamp(6)

  @@map("session")
}
